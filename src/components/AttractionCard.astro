---
import { ArrowUpRight } from '@lucide/astro';
import MediaFrame from './MediaFrame.astro';
import DraftFlag from './DraftFlag.astro';
import type { Attraction } from '../lib/resolve.ts';
import { site } from '../lib/content.ts';

interface Props {
  attraction: Attraction;
  /** Show the primary category label */
  showCategory?: boolean;
  sizes?: string;
  headingLevel?: 2 | 3;
}
const { attraction: a, showCategory = false, sizes = '(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw', headingLevel = 3 } = Astro.props;
const category = showCategory ? (await site()).categoryById.get(a.primaryCategory) : undefined;
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="group relative flex flex-col" data-reveal>
  <MediaFrame media={a.stills[0] ?? a.videos[0]} aspect="4 / 3" sizes={sizes} class="rounded-[var(--radius-card)] bg-mist" imgClass="transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]" />
  <div class="mt-5 flex items-start justify-between gap-4">
    <div>
      {category && <p class="mb-2 text-[0.8rem] font-semibold tracking-[0.1em] text-muted uppercase">{category.name}</p>}
      <H class="t-h3">
        <a href={`/attractions/${a.slug}/`} class="after:absolute after:inset-0 after:content-['']">{a.name}</a>
      </H>
      <p class="mt-2 text-muted">{a.summary}</p>
      <DraftFlag when={a.draft} class="mt-3" />
    </div>
    <span class="mt-1 flex size-10 shrink-0 items-center justify-center rounded-full border border-line-strong transition-colors duration-300 group-hover:border-brand-deep group-hover:bg-brand-deep group-hover:text-white" aria-hidden="true">
      <ArrowUpRight class="size-4" />
    </span>
  </div>
</article>

---
/**
 * Office location: OpenStreetMap embed (free, no API key, no backend) with the office marker.
 * The iframe is lazy-loaded; the panel behind it stays readable if the map never loads.
 * Coordinates and address come only from company.contact (single source).
 */
import { MapPin, Navigation, ExternalLink } from '@lucide/astro';
import { company } from '../config/company.ts';

const { lat, lon, label } = company.contact.location;
const dLat = 0.0035;
const dLon = 0.0055;
const bbox = [lon - dLon, lat - dLat, lon + dLon, lat + dLat].map((n) => n.toFixed(6)).join(',');
const embed = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
---

<div class="grid gap-8 xl:grid-cols-12 xl:items-stretch">
  <div class="relative overflow-hidden rounded-[var(--radius-stage)] border border-line bg-mist xl:col-span-8" style="aspect-ratio: 16 / 10">
    <!-- Fallback, visible until (or unless) the map loads over it -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center text-muted">
      <MapPin class="size-6 text-brand-violet" aria-hidden="true" />
      <p class="max-w-[36ch] text-[0.95rem]">If the map does not load, open the location on <a class="link" href={osm} target="_blank" rel="noopener">OpenStreetMap</a> or get <a class="link" href={directions} target="_blank" rel="noopener">directions in Google Maps</a>.</p>
    </div>
    <iframe
      src={embed}
      title={`Map showing the location of ${label}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="absolute inset-0 size-full border-0"
    ></iframe>
    <p class="pointer-events-none absolute top-4 left-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-[0.875rem] font-semibold text-text shadow-lift">
      <MapPin class="size-4 text-brand-deep" aria-hidden="true" /> {label}
    </p>
  </div>

  <div class="flex flex-col justify-between gap-8 rounded-[var(--radius-stage)] border border-line bg-white p-8 sm:flex-row sm:items-end xl:col-span-4 xl:flex-col xl:items-stretch">
    <div>
      <p class="text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">Office address</p>
      <address class="mt-4 text-[1.1rem] leading-relaxed not-italic">
        <strong class="block font-semibold">{company.name}</strong>
        {company.contact.address.value.map((l) => <span class="block">{l}</span>)}
      </address>
    </div>
    <div class="flex flex-col gap-3">
      <a href={directions} target="_blank" rel="noopener" class="btn btn-primary">
        <Navigation aria-hidden="true" /> Directions in Google Maps
      </a>
      <a href={osm} target="_blank" rel="noopener" class="btn btn-outline">
        View larger map <ExternalLink aria-hidden="true" />
      </a>
    </div>
  </div>
</div>

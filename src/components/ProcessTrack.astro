---
/**
 * Turnkey delivery stages from canonical `delivery_stage` capability records,
 * in their confirmed order. A scroll-linked rail fills as the section passes.
 */
import DraftFlag from './DraftFlag.astro';
import ModelTag from './ModelTag.astro';
import type { Capability } from '../lib/resolve.ts';

interface Props {
  stages: Capability[];
  showModel?: boolean;
  /** Names only — the homepage preview. Descriptions and delivery models live on the Turnkey page. */
  compact?: boolean;
}
const { stages, showModel = true, compact = false } = Astro.props;
const cols = { 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5', 6: 'lg:grid-cols-6' }[Math.min(stages.length, 6)] ?? 'lg:grid-cols-6';
---

<div class="relative">
  <!-- Rail (desktop: horizontal; mobile: vertical) -->
  <div class="absolute top-[1.375rem] right-0 left-0 hidden h-px bg-line-strong lg:block" aria-hidden="true">
    <div class="h-full origin-left bg-gradient-to-r from-brand-blue via-brand-violet to-brand-magenta" data-progress></div>
  </div>
  <div class="absolute top-0 bottom-0 left-[1.375rem] w-px bg-line-strong lg:hidden" aria-hidden="true"></div>

  <ol class:list={['relative grid gap-10 lg:gap-6', cols]}>
    {
      stages.map((s, i) => (
        <li class="relative grid grid-cols-[2.75rem_1fr] gap-5 lg:block" data-reveal>
          <span class="relative z-10 flex size-11 items-center justify-center rounded-full border border-line-strong bg-white font-display text-[0.95rem] font-semibold tabular-nums shadow-[0_0_0_6px_var(--color-paper)]">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="lg:mt-7 lg:pr-4">
            <h3 class="text-[1.2rem] font-semibold">{s.name}</h3>
            {!compact && <p class="mt-2 text-[0.975rem] text-muted">{s.description}</p>}
            <div class="mt-3 flex flex-wrap gap-2">
              {showModel && !compact && <ModelTag model={s.deliveryModel} />}
              <DraftFlag when={s.draft} />
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>

---
/**
 * Click-to-load embed for externally hosted video. Nothing from the host loads until
 * the visitor presses play (no third-party requests on page load). Without JS the
 * button is a plain link to the video on its host.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Play } from '@lucide/astro';
import type { Media } from '../lib/resolve.ts';

interface Props {
  media: Media;
  poster?: ImageMetadata;
  posterAlt?: string;
}
const { media, poster } = Astro.props;
const ext = media.external!;
const embed =
  ext.provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(ext.id)}?autoplay=1&rel=0`
    : `https://player.vimeo.com/video/${encodeURIComponent(ext.id)}?autoplay=1&dnt=1`;
const watch = ext.provider === 'youtube' ? `https://www.youtube.com/watch?v=${encodeURIComponent(ext.id)}` : `https://vimeo.com/${encodeURIComponent(ext.id)}`;
const title = media.caption ?? media.alt ?? 'Video';
---

<div class="absolute inset-0 bg-ink-950" data-video data-embed={embed} data-title={title}>
  {poster && <Image src={poster} alt="" widths={[640, 1280]} sizes="(min-width:1024px) 60vw, 100vw" class="absolute inset-0 size-full object-cover opacity-80" />}
  <a href={watch} class="group absolute inset-0 flex items-center justify-center" data-video-play rel="noopener" target="_blank">
    <span class="flex size-20 items-center justify-center rounded-full bg-white/95 text-ink-900 shadow-lift transition-transform duration-300 group-hover:scale-105">
      <Play class="ml-1 size-8" aria-hidden="true" />
    </span>
    <span class="sr-only">Play video: {title}</span>
  </a>
</div>
{media.textAlternative && <p class="sr-only">{media.textAlternative}</p>}

<script>
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-video-play]');
    const box = a?.closest<HTMLElement>('[data-video]');
    if (!a || !box) return;
    e.preventDefault();
    const f = document.createElement('iframe');
    f.src = box.dataset.embed!;
    f.title = box.dataset.title!;
    f.allow = 'autoplay; fullscreen; picture-in-picture';
    f.allowFullscreen = true;
    f.className = 'absolute inset-0 size-full';
    box.replaceChildren(f);
    f.focus();
  });
</script>

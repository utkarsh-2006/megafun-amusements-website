---
/** Spec-sheet list of canonical technical / facility / service capability records. */
import ModelTag from './ModelTag.astro';
import DraftFlag from './DraftFlag.astro';
import MediaFrame from './MediaFrame.astro';
import type { Capability } from '../lib/resolve.ts';

interface Props {
  items: Capability[];
  showEvidence?: boolean;
}
const { items, showEvidence = false } = Astro.props;
const kindLabel = { technical: 'Technical capability', facility: 'Facility', service: 'Service', delivery_stage: 'Delivery stage' };
---

<dl class="divide-y divide-line border-y border-line">
  {
    items.map((c) => (
      <div class="grid gap-4 py-8 md:grid-cols-12 md:gap-8" data-reveal>
        <dt class="md:col-span-5">
          <p class="text-[0.78rem] font-semibold tracking-[0.12em] text-muted uppercase">{kindLabel[c.kind]}</p>
          <p class="t-h3 mt-2">{c.name}</p>
        </dt>
        <dd class="md:col-span-7">
          <p class="text-[1.075rem]">{c.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <ModelTag model={c.deliveryModel} />
            <DraftFlag when={c.draft} />
          </div>
          {showEvidence && c.evidenceItems.length > 0 && (
            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {c.evidenceItems.map((m) => (
                <MediaFrame media={m} aspect="4 / 3" sizes="(min-width:768px) 20vw, 50vw" class="rounded-xl" />
              ))}
            </div>
          )}
        </dd>
      </div>
    ))
  }
</dl>

---
import MediaFrame from './MediaFrame.astro';
import DraftFlag from './DraftFlag.astro';
import type { Article } from '../lib/resolve.ts';
import { formatDate } from '../lib/content.ts';

interface Props {
  article: Article;
  large?: boolean;
}
const { article: a, large = false } = Astro.props;
---

<article class:list={['group relative grid gap-6', large && 'md:grid-cols-2 md:items-center md:gap-12']} data-reveal>
  <MediaFrame media={a.coverItem} aspect="16 / 10" sizes={large ? '(min-width:768px) 50vw, 100vw' : '(min-width:1024px) 30vw, 100vw'} class="rounded-[var(--radius-card)]" imgClass="transition-transform duration-700 group-hover:scale-[1.03]" />
  <div>
    <p class="flex flex-wrap gap-x-3 text-[0.85rem] text-muted">
      <time datetime={a.date.toISOString().slice(0, 10)}>{formatDate(a.date)}</time>
      {a.type && <span class="font-semibold text-blue-700">{a.type}</span>}
    </p>
    <h3 class:list={[large ? 't-h2' : 't-h3', 'mt-3']}>
      <a href={`/updates/${a.id}/`} class="after:absolute after:inset-0 after:content-[''] group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{a.title}</a>
    </h3>
    <p class="mt-3 text-muted">{a.summary}</p>
    <DraftFlag when={a.draft} class="mt-3" />
  </div>
</article>

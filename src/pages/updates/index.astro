---
/**
 * /updates/ — always present (top-level navigation). Two sections:
 *   1. Company updates — featured latest article, then the rest newest first.
 *   2. Gallery — curated, approved company photographs (media records with `gallery: true`),
 *      in a paginated carousel of four per desktop page.
 * Each section has its own deliberate empty state.
 */
import { ArrowRight, Images } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsCard from '../../components/NewsCard.astro';
import Gallery from '../../components/Gallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import EnquiryClose from '../../components/EnquiryClose.astro';
import { site } from '../../lib/content.ts';

const r = await site();
const [first, ...rest] = r.news;
---

<Base title="Updates & Gallery" description="Company updates, announcements and a photo gallery from Mega Fun Amusements." pageType="updates">
  <!-- ══ Section 1: company updates ════════════════════════════════════════ -->
  <section id="news" class="scroll-mt-24 border-b border-line" aria-labelledby="h-updates">
    <div class="wrap pt-8 pb-20 lg:pt-10 lg:pb-28">
      <Breadcrumbs items={[{ label: 'Updates' }]} />
      <div class="mt-10 max-w-3xl lg:mt-14">
        <p class="eyebrow text-blue-700" data-hero-line>Updates</p>
        <h1 id="h-updates" class="t-display mt-5" data-hero-line>Company updates</h1>
        <p class="t-lead mt-6 text-muted" data-hero-line>Dated announcements on new attractions, projects and company developments, followed by our photo gallery.</p>
      </div>

      {
        first ? (
          <div class="mt-16">
            <h2 class="mb-8 text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">Latest</h2>
            <NewsCard article={first} large />
            {rest.length > 0 && (
              <div class="mt-20 border-t border-line pt-16">
                <h2 class="mb-10 text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">Earlier updates</h2>
                <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">{rest.map((a) => <NewsCard article={a} />)}</div>
              </div>
            )}
          </div>
        ) : (
          <div class="mt-16 max-w-2xl rounded-[var(--radius-stage)] border border-line bg-white p-8 lg:p-12" data-reveal>
            <h2 class="t-h3">No updates published yet</h2>
            <p class="mt-3 text-muted">Company announcements will appear here as they are published, newest first.</p>
            <a href="/contact/" class="btn btn-outline mt-8">Contact us <ArrowRight class="arrow" aria-hidden="true" /></a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ Section 2: gallery ═════════════════════════════════════════════════ -->
  <section id="gallery" class="scroll-mt-24 bg-white" aria-labelledby="h-gallery">
    <div class="wrap py-20 lg:py-28">
      <div class="grid gap-6 md:grid-cols-12 md:items-end" data-reveal>
        <div class="md:col-span-7">
          <p class="eyebrow text-blue-700">Photos</p>
          <h2 id="h-gallery" class="t-h2 mt-5">Gallery</h2>
        </div>
        <p class="text-muted md:col-span-5">Photographs of our attractions, workshop and installations. Select any image to view it larger.</p>
      </div>
      <div class="mt-12">
        {
          r.gallery.length > 0 ? (
            <Gallery items={r.gallery} id="updates-gallery" label="Mega Fun Amusements photo gallery" />
          ) : (
            <div class="flex max-w-2xl items-start gap-4 rounded-[var(--radius-stage)] border border-line bg-paper p-8 lg:p-12">
              <Images class="mt-1 size-6 shrink-0 text-brand-violet" aria-hidden="true" />
              <div>
                <h3 class="t-h3">Photographs coming soon</h3>
                <p class="mt-3 text-muted">Approved photographs of our attractions and installations will be shown here.</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <div class="pt-3"><EnquiryClose source="updates" /></div>
  {r.gallery.length > 0 && <Lightbox />}
</Base>

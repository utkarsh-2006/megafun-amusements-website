---
/** Pre-rendered filter view: canonical /projects/, noindex (brief §3.2). */
import Base from '../../../layouts/Base.astro';
import ProjectsArchive from '../../../components/ProjectsArchive.astro';
import { site } from '../../../lib/content.ts';

export async function getStaticPaths() {
  return (await site()).filters.byAttraction.map((c) => ({ params: { slug: c.slug }, props: { id: c.id, name: c.name } }));
}
const { id, name } = Astro.props;
---

<Base title={`Projects: ${name}`} description={`Mega Fun Amusements projects featuring ${name.toLowerCase()}.`} canonical="/projects/" noindex pageType="projects">
  <ProjectsArchive filter={{ kind: 'attraction', id }} />
</Base>

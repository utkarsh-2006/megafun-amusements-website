---
/**
 * Homepage — the company overview. Copy comes from src/config/homepage.ts (owner's refined
 * draft) and lives only here; Attractions and Turnkey & Engineering carry the detail and are
 * linked, not repeated. Data-driven sections (venues, work, updates) render only when their
 * content gates pass; section numbers follow what renders.
 */
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Ribbon from '../components/Ribbon.astro';
import MediaFrame from '../components/MediaFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessTrack from '../components/ProcessTrack.astro';
import NewsCard from '../components/NewsCard.astro';
import EnquiryClose from '../components/EnquiryClose.astro';
import DraftFlag from '../components/DraftFlag.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../lib/content.ts';
import { contactHref } from '../lib/enquiry.ts';
import { company } from '../config/company.ts';
import { homepage as h } from '../config/homepage.ts';
import { previewMode } from '../config/build.ts';

const r = await site();
const stages = r.capabilities.filter((c) => c.kind === 'delivery_stage');
const show = (f: { confirmed: boolean }) => f.confirmed || previewMode;
const facts = [
  show(company.founded) && { k: 'Established', v: String(company.founded.value), draft: !company.founded.confirmed },
  company.contact.location.verified && { k: 'Based in', v: 'Chennai, India', draft: false },
  show(company.markets) && company.markets.value.length > 0 && { k: 'Markets', v: company.markets.value.join(', '), draft: !company.markets.confirmed },
  r.attractions.length > 0 && { k: 'Attractions listed', v: String(r.attractions.length), draft: false },
].filter(Boolean) as { k: string; v: string; draft: boolean }[];
const venues = r.venues;
const verify = 'Awaiting owner verification';

// Portfolio groups (company copy) linked to whichever mapped categories are published.
const groups = h.portfolio.groups.map((g) => {
  const cats = (g.categories as readonly string[]).map((id) => r.categoryById.get(id)).filter((c) => !!c);
  const thumbs = cats.flatMap((c) => c.attractions).slice(0, 3);
  const href = cats.length === 1 && cats[0].hasPage ? `/attractions/category/${cats[0].slug}/` : cats.length ? `/attractions/#${cats[0].slug}` : undefined;
  return { ...g, thumbs, href, count: cats.reduce((n, c) => n + c.attractions.length, 0) };
});

// Hero composition: one still from each of up to three categories.
const heroPicks = r.categories.map((c) => c.attractions.find((a) => a.stills[0])).filter((a) => !!a).slice(0, 3);

const sections = [
  'about',
  'portfolio',
  venues.length && 'venues',
  'engineering',
  'turnkey',
  r.selectedWork.length && 'work',
  r.homeNews.length && 'news',
  'closing',
].filter(Boolean) as string[];
const idx = (s: string) => String(sections.indexOf(s) + 1).padStart(2, '0');
---

<Base fullTitle={h.seo.title} description={h.seo.description} pageType="home">
  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="px-3 pt-1 sm:px-4" aria-labelledby="hero-title">
    <div class="stage on-dark">
      <div class="pointer-events-none absolute -top-40 -left-32 size-[34rem] rounded-full bg-brand-blue/25 blur-[120px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-24 bottom-[-12rem] size-[30rem] rounded-full bg-brand-magenta/20 blur-[120px]" aria-hidden="true"></div>
      <!--
        Hero curve. Below lg (stacked layout) it keeps its original sizing. From lg up its box is set
        in percentages of the hero panel (inset), and the SVG fits the whole curve inside that box
        at its fixed 2:1 proportions ("xMaxYMax meet"): bottom-right anchored, never clipped,
        whatever the panel's width/height ratio (browser zoom, 1366–2560px screens).
      -->
      <Ribbon
        draw="load"
        id="hero-ribbon"
        width={26}
        leadIn
        align="xMaxYMax meet"
        class="pointer-events-none absolute top-[38%] left-[-8%] w-[160%] max-w-none overflow-visible text-white sm:w-[125%] lg:top-[26%] lg:left-[-3%] lg:h-[81%] lg:w-[106%] xl:top-[24%] xl:h-[83%]"
      />

      <div class="wrap relative grid min-h-[min(88svh,56rem)] gap-14 pt-16 pb-12 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-20 lg:pb-32">
        <div class:list={['relative', heroPicks.length ? 'lg:col-span-7' : 'lg:col-span-10']}>
          <!-- Descriptive H1 for search; the large line below is the visual tagline. -->
          <h1 id="hero-title" class="eyebrow max-w-[60ch] text-blue-300 [text-wrap:balance]" data-hero-line>{h.h1}</h1>
          <p class="t-hero mt-6 font-display">
            <span class="block" data-hero-line>Attractions,</span>
            <span class="block" data-hero-line>engineered</span>
            <span class="block" data-hero-line>
              to <span class="bg-gradient-to-r from-blue-300 via-brand-violet to-brand-magenta bg-clip-text pr-1 text-transparent">thrill.</span>
            </span>
          </p>
          <p class="t-lead mt-8 max-w-[46ch] text-on-dark-muted" data-hero-line>{h.tagline}</p>
          <div class="mt-10 flex flex-wrap gap-3" data-hero-line>
            {
              r.attractions.length > 0 && (
                <a href="/attractions/" class="btn btn-light">
                  Explore attractions <ArrowRight class="arrow" aria-hidden="true" />
                </a>
              )
            }
            <a
              href={contactHref({ intent: 'project', source: 'home' })}
              class:list={['btn', r.attractions.length ? 'btn-ghost-dark' : 'btn-light']}
              data-track="project_cta_click"
              data-track-source="home"
            >
              Discuss a Project {!r.attractions.length && <ArrowRight class="arrow" aria-hidden="true" />}
            </a>
          </div>
        </div>

        {
          heroPicks.length > 0 && (
            <div class="relative lg:col-span-5" aria-label="Featured attractions">
              <div class="grid grid-cols-6 gap-3 sm:gap-4">
                {heroPicks.map((a, i) => (
                  <a
                    href={`/attractions/${a.slug}/`}
                    class:list={[
                      'mf-glow group relative block overflow-hidden rounded-2xl ring-1 ring-white/10',
                      i === 0 && 'col-span-6 sm:col-span-4 sm:row-span-2',
                      i > 0 && 'col-span-3 sm:col-span-2',
                    ]}
                    data-hero-line
                  >
                    <MediaFrame media={a.stills[0]} aspect={i === 0 ? '4 / 5' : '3 / 4'} sizes={i === 0 ? '(min-width:1024px) 26vw, 90vw' : '(min-width:1024px) 13vw, 45vw'} eager={i === 0} tone="dark" imgClass="transition-transform duration-700 group-hover:scale-105" />
                    <span class="absolute inset-x-2 bottom-2 flex items-center justify-between gap-2 rounded-xl bg-ink-950/75 px-3 py-2 text-[0.8rem] font-semibold text-white backdrop-blur">
                      {a.name}
                      <ArrowUpRight class="size-3.5 shrink-0" aria-hidden="true" />
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ── About Mega Fun Amusements (the only company introduction on the site) ── -->
  <section id="company" class="scroll-mt-24 border-b border-line bg-white" aria-labelledby="h-about">
    <div class="wrap grid gap-14 py-24 lg:grid-cols-12 lg:py-32">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow text-blue-700"><span>{idx('about')}</span>About us</p>
        <h2 id="h-about" class="t-h2 mt-5">{h.about.heading}</h2>
        <div class="prose-mf mt-8 text-[1.15rem]">{h.about.body.map((p) => <p>{p}</p>)}</div>
        <DraftFlag when={!h.approved} label={verify} class="mt-4" />
      </div>
      {
        facts.length > 0 && (
          <dl class="self-start rounded-[var(--radius-card)] border border-line bg-paper p-8 lg:col-span-4 lg:col-start-9" data-reveal>
            {facts.map((f) => (
              <div class="border-b border-line py-4 first:pt-0 last:border-0 last:pb-0">
                <dt class="text-[0.8rem] font-semibold tracking-[0.1em] text-muted uppercase">{f.k}</dt>
                <dd class="mt-1 font-display text-[1.5rem] font-semibold">
                  {f.v} <DraftFlag when={f.draft} />
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- ── Our Attraction Portfolio ─────────────────────────────────────────── -->
  <section class="wrap py-24 lg:py-36" aria-labelledby="h-portfolio">
    <SectionHead id="h-portfolio" index={idx('portfolio')} eyebrow="What we create" title={h.portfolio.heading} intro={h.portfolio.intro}>
      {r.attractions.length > 0 && <a href="/attractions/" class="link mt-6 inline-flex items-center gap-2">Browse all attractions <ArrowRight class="size-4" aria-hidden="true" /></a>}
    </SectionHead>
    <ol class="mt-14 border-t border-line lg:mt-20">
      {
        groups.map((g, i) => (
          <li class="group relative border-b border-line" data-reveal>
            <div class="grid items-center gap-5 py-8 md:grid-cols-12 md:gap-8 lg:py-10">
              <span class="font-display text-[0.95rem] font-semibold text-muted tabular-nums md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <h3 class:list={['font-display text-[clamp(1.6rem,1.2rem+1.6vw,2.4rem)] leading-tight font-semibold tracking-tight md:col-span-4', g.href && 'transition-colors group-hover:text-brand-deep']}>
                {g.href ? <a href={g.href} class="after:absolute after:inset-0 after:content-['']">{g.title}</a> : g.title}
              </h3>
              <p class:list={['text-muted', g.thumbs.length ? 'md:col-span-4' : 'md:col-span-7']}>
                {g.text}
                {g.count > 0 && <span class="mt-2 block text-[0.875rem] font-semibold text-text">{g.count} listed {g.count === 1 ? 'attraction' : 'attractions'}</span>}
              </p>
              {g.thumbs.length > 0 && (
                <div class="flex items-center justify-end gap-2 md:col-span-3" aria-hidden="true">
                  {g.thumbs.map((a, j) => (
                    <MediaFrame
                      media={a.stills[0]}
                      aspect="1 / 1"
                      sizes="96px"
                      widths={[192]}
                      class:list={['w-16 rounded-xl transition-transform duration-500 ease-[var(--ease-out-quint)] sm:w-20', j === 1 && 'group-hover:-translate-y-2', j === 2 && 'group-hover:translate-y-2']}
                    />
                  ))}
                  <span class="ml-2 flex size-11 shrink-0 items-center justify-center rounded-full border border-line-strong transition-colors group-hover:border-brand-deep group-hover:bg-brand-deep group-hover:text-white">
                    <ArrowRight class="size-4" />
                  </span>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <DraftFlag when={!h.approved} label={verify} class="mt-6" />
  </section>

  <!-- ── Venue types (records) ────────────────────────────────────────────── -->
  {
    venues.length > 0 && (
      <section class="border-y border-line bg-white" aria-labelledby="h-venues">
        <div class="wrap py-24 lg:py-32">
          <SectionHead id="h-venues" index={idx('venues')} eyebrow="Where they go" title="Planned around the venue" intro="Different venues ask different questions about space, guest flow and operation." />
          <ul class:list={['mt-14 grid gap-4', venues.length % 3 === 0 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
            {venues.map((v) => (
              <li class="group relative flex flex-col rounded-[var(--radius-card)] border border-line bg-paper p-8 transition-shadow hover:shadow-lift lg:p-10" data-reveal>
                <h3 class="t-h3">{v.hasPage ? <a href={`/solutions/${v.slug}/`} class="after:absolute after:inset-0 after:content-['']">{v.name}</a> : v.name}</h3>
                <p class="mt-3 text-muted">{v.summary}</p>
                {v.needs.length > 0 && (
                  <ul class="mt-6 space-y-2 border-t border-line pt-6 text-[0.95rem]">
                    {v.needs.map((n) => (
                      <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand-violet" aria-hidden="true" />{n.title}</li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto pt-6"><DraftFlag when={v.draft} /></div>
                {v.hasPage && <ArrowUpRight class="absolute top-8 right-8 size-5 text-muted transition-colors group-hover:text-brand-deep" aria-hidden="true" />}
              </li>
            ))}
          </ul>
          {r.solutionsLive && (
            <a href="/solutions/" class="link mt-8 inline-flex items-center gap-2">All venue solutions <ArrowRight class="size-4" aria-hidden="true" /></a>
          )}
        </div>
      </section>
    )
  }

  <!-- ── Engineering Expertise & Innovation ───────────────────────────────── -->
  <section class:list={['border-line', venues.length ? '' : 'border-t bg-white']} aria-labelledby="h-engineering">
    <div class="wrap grid gap-12 py-24 lg:grid-cols-12 lg:py-32">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32" data-reveal>
          <p class="eyebrow text-blue-700"><span>{idx('engineering')}</span>Engineering</p>
          <h2 id="h-engineering" class="t-h2 mt-5">{h.engineering.heading}</h2>
          <a href="/turnkey-engineering/" class="link mt-8 inline-flex items-center gap-2">Turnkey &amp; Engineering <ArrowRight class="size-4" aria-hidden="true" /></a>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal>
        <div class="prose-mf text-[1.15rem]">{h.engineering.body.map((p) => <p>{p}</p>)}</div>
        <DraftFlag when={!h.approved} label={verify} class="mt-4" />
      </div>
    </div>
  </section>

  <!-- ── Complete Turnkey Amusement Solutions ─────────────────────────────── -->
  <section class="border-t border-line" aria-labelledby="h-turnkey">
    <div class="wrap py-24 lg:py-36">
      <div class="grid gap-10 lg:grid-cols-12" data-reveal>
        <div class="lg:col-span-5">
          <p class="eyebrow text-blue-700"><span>{idx('turnkey')}</span>Turnkey delivery</p>
          <h2 id="h-turnkey" class="t-h2 mt-5">{h.turnkey.heading}</h2>
        </div>
        <div class="lg:col-span-7">
          <div class="prose-mf text-[1.15rem]">{h.turnkey.body.map((p) => <p>{p}</p>)}</div>
          <DraftFlag when={!h.approved} label={verify} class="mt-4" />
          <a href="/turnkey-engineering/" class="link mt-6 inline-flex items-center gap-2">How a project runs <ArrowRight class="size-4" aria-hidden="true" /></a>
        </div>
      </div>
      {stages.length > 0 && <div class="mt-16 lg:mt-24"><ProcessTrack stages={stages} compact /></div>}
    </div>
  </section>

  <!-- ── Selected work ─────────────────────────────────────────────────── -->
  {
    r.selectedWork.length > 0 && (
      <section class="px-3 pt-3 sm:px-4" aria-labelledby="h-work">
        <div class="stage on-dark">
          <div class="wrap py-24 lg:py-32">
            <SectionHead id="h-work" index={idx('work')} eyebrow="Selected work" title="Attractions in the real world" dark intro={r.projectsLive ? 'A selection of approved installations and projects.' : undefined} />
            <div class:list={['mt-14 grid gap-x-8 gap-y-14', r.selectedWork.length > 1 && 'md:grid-cols-2', r.selectedWork.length > 2 && 'lg:grid-cols-3']}>
              {r.selectedWork.map((p) => <ProjectCard project={p} dark />)}
            </div>
            {r.projectsLive && (
              <a href="/projects/" class="btn btn-ghost-dark mt-14">View all projects <ArrowRight class="arrow" aria-hidden="true" /></a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- ── Latest updates (freshness gate) ──────────────────────────────────── -->
  {
    r.homeNews.length > 0 && (
      <section class="border-t border-line bg-white" aria-labelledby="h-news">
        <div class="wrap py-24 lg:py-32">
          <SectionHead id="h-news" index={idx('news')} eyebrow="Latest updates" title="News from Mega Fun">
            <a href="/updates/" class="link inline-flex items-center gap-2">All updates <ArrowRight class="size-4" aria-hidden="true" /></a>
          </SectionHead>
          <div class="mt-14 grid gap-12 md:grid-cols-3">{r.homeNews.map((a) => <NewsCard article={a} />)}</div>
        </div>
      </section>
    )
  }

  <!-- ── Creating Memorable Entertainment Experiences ─────────────────────── -->
  <section class="border-t border-line" aria-labelledby="h-closing">
    <div class="wrap grid gap-10 py-24 lg:grid-cols-12 lg:py-32" data-reveal>
      <div class="lg:col-span-5">
        <p class="eyebrow text-blue-700"><span>{idx('closing')}</span>Our aim</p>
        <h2 id="h-closing" class="t-h2 mt-5">{h.closing.heading}</h2>
      </div>
      <div class="prose-mf text-[1.15rem] lg:col-span-7">{h.closing.body.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <div class="pt-3">
    <EnquiryClose source="home" />
  </div>
  {r.selectedWork.length > 0 && <Lightbox />}
</Base>

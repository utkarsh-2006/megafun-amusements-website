---
/**
 * Contact — exactly two major sections:
 *   1. #enquiry  Contact & enquiry: intro, direct contact details and enquiry controls (left),
 *                draft email card with product selector, email and WhatsApp actions (right).
 *   2. #office   Office location map.
 * No server-side form: the page composes a draft the visitor sends themselves. Without JS the
 * static mailto routes (right column) and the contact details are the complete experience.
 */
import { Mail, Phone, Copy, ExternalLink, Download, MapPin, MessageCircle, RotateCcw } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OfficeMap from '../components/OfficeMap.astro';
import EmailLink from '../components/EmailLink.astro';
import DraftFlag from '../components/DraftFlag.astro';
import { site } from '../lib/content.ts';
import { intents, intentLabels, composeDraft, whatsappHref, whatsappText, type Intent } from '../lib/enquiry.ts';
import { company, publicContact } from '../config/company.ts';

const r = await site();
const intentHelp: Record<Intent, string> = {
  project: 'Planning a new venue, zone or attraction.',
  specification: 'Technical details for a specific attraction.',
  service: 'Support for an attraction you already operate.',
  general: 'Suppliers, partners and everything else.',
};
const staticDrafts = intents.map((i) => ({ intent: i, ...composeDraft(i, {}) }));
const venues = r.venues.map((v) => ({ value: v.slug, label: v.name }));
// Only publishable attractions (drafts appear in preview builds only).
const products = r.attractions.filter((a) => a.operationalStatus === 'active').map((a) => ({ value: a.slug, label: a.name }));
const wa = company.contact.whatsapp.value;
const waStatic = wa ? whatsappHref(wa, whatsappText('general', {})) : '';
const loc = company.contact.location;
const field = 'mt-2 block w-full rounded-xl border border-line-strong bg-white px-4 py-3 text-[1rem] transition-colors focus:border-brand-deep focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-violet/20';
const label = 'text-[0.9rem] font-semibold';
const detailLabel = 'block text-[0.8rem] font-semibold tracking-[0.08em] text-muted uppercase';
---

<Base
  title="Contact"
  description="Contact Mega Fun Amusements: email, phone, WhatsApp, our Chennai office location and a guided enquiry for projects, specifications and service."
  pageType="contact"
>
  <script is:inline>
    // Contextual query variants must not be indexed; the canonical stays /contact/.
    if (location.search) document.querySelector('meta[name=robots]').setAttribute('content', 'noindex, follow');
  </script>

  <!-- ══ Section 1: contact & enquiry ══════════════════════════════════════ -->
  <section id="enquiry" class="scroll-mt-24 border-b border-line" aria-labelledby="contact-title">
    <div class="wrap pt-8 pb-16 lg:pt-10 lg:pb-24">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-14">
        <!-- Left: introduction, direct details, enquiry controls -->
        <div class="lg:col-span-7">
          <p class="eyebrow text-blue-700" data-hero-line>Contact</p>
          <h1 id="contact-title" class="t-display mt-5 max-w-[16ch]" data-hero-line>Discuss a project, or just get in touch</h1>
          <p class="t-lead mt-6 max-w-[56ch] text-muted" data-hero-line>
            New projects, specification requests, support for installed attractions and general questions all start here. Choose what you need and we prepare a
            draft for you to review and send.
          </p>

          <dl class="mt-10 grid gap-x-8 gap-y-6 rounded-[var(--radius-card)] border border-line bg-white p-6 sm:grid-cols-2 lg:p-8" data-hero-line>
            <div class="flex gap-3">
              <Mail class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
              <div><dt class={detailLabel}>Email</dt><dd class="mt-1 font-semibold [overflow-wrap:anywhere]"><EmailLink class="hover:text-blue-700" source="contact" /></dd></div>
            </div>
            <div class="flex gap-3">
              <Phone class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
              <div><dt class={detailLabel}>Phone</dt><dd class="mt-1 font-semibold"><a href={`tel:${publicContact.phone.tel}`} class="hover:text-blue-700" data-track="phone_click" data-track-source="contact">{publicContact.phone.display}</a></dd></div>
            </div>
            {
              wa && (
                <div class="flex gap-3">
                  <MessageCircle class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
                  <div>
                    <dt class={detailLabel}>WhatsApp</dt>
                    <dd class="mt-1 font-semibold">
                      <a href={waStatic} target="_blank" rel="noopener" class="hover:text-blue-700" data-track="whatsapp_open" data-track-source="contact">Message us on WhatsApp</a>
                      <DraftFlag when={!company.contact.whatsapp.confirmed} />
                    </dd>
                  </div>
                </div>
              )
            }
            {
              loc.verified && (
                <div class="flex gap-3 sm:col-span-2">
                  <MapPin class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
                  <div>
                    <dt class={detailLabel}>Office</dt>
                    <dd class="mt-1">
                      <address class="not-italic">{company.contact.address.value.join(', ')}</address>
                      <a href="#office" class="link mt-1 inline-block text-[0.9rem]">See the map</a>
                    </dd>
                  </div>
                </div>
              )
            }
          </dl>

          <!-- Enquiry controls (JS) -->
          <div class="mt-12" data-builder-controls hidden>
            <fieldset>
              <legend class="text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">I am contacting you about</legend>
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                {
                  intents.map((i) => (
                    <label class="relative flex cursor-pointer flex-col rounded-2xl border border-line-strong bg-white p-5 transition-colors has-checked:border-brand-deep has-checked:bg-brand-deep/[0.04] has-focus-visible:ring-4 has-focus-visible:ring-brand-violet/25">
                      <input type="radio" name="intent" value={i} class="peer sr-only" checked={i === 'project'} />
                      <span class="font-semibold">{intentLabels[i]}</span>
                      <span class="mt-1 text-[0.9rem] text-muted">{intentHelp[i]}</span>
                      <span class="absolute top-5 right-5 size-4 rounded-full border-2 border-line-strong peer-checked:border-[5px] peer-checked:border-brand-deep" aria-hidden="true" />
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              <p class="text-[0.9rem] text-muted sm:col-span-2">All fields are optional. Add as much or as little as you like.</p>
              <label class="block"><span class={label}>Your name</span><input class={field} name="name" autocomplete="name" /></label>
              <label class="block"><span class={label}>Company</span><input class={field} name="company" autocomplete="organization" /></label>
              {
                products.length > 0 && (
                  <label class="block">
                    <span class={label}>Attraction of interest</span>
                    <select class={field} name="attraction" data-product>
                      <option value="">Not sure yet</option>
                      {products.map((a) => <option value={a.value}>{a.label}</option>)}
                    </select>
                  </label>
                )
              }
              <label class="block" data-for="project">
                <span class={label}>Venue type</span>
                <select class={field} name="venue">
                  <option value="">Select…</option>
                  {venues.map((v) => <option value={v.value}>{v.label}</option>)}
                  <option value="other">Other</option>
                </select>
              </label>
              <label class="block" data-for="project"><span class={label}>Location</span><input class={field} name="location" placeholder="City, country" autocomplete="address-level2" /></label>
              <label class="block" data-for="project">
                <span class={label}>Timeline</span>
                <select class={field} name="timeline">
                  <option value="">Select…</option>
                  <option>Within 6 months</option>
                  <option>6–12 months</option>
                  <option>More than 12 months</option>
                  <option>Still exploring</option>
                </select>
              </label>
              <label class="block sm:col-span-2" data-for="project">
                <span class={label}>Known site constraints</span>
                <textarea class={field} name="constraints" rows="3" placeholder="Approximate area, ceiling height, power, indoor/outdoor…"></textarea>
              </label>
              <label class="block sm:col-span-2" data-for="specification service general">
                <span class={label}>Message</span>
                <textarea class={field} name="message" rows="4"></textarea>
              </label>
            </div>
          </div>
        </div>

        <!-- Right: draft email card (JS) / static routes (no JS) -->
        <div class="lg:col-span-5">
          <ul class="grid gap-4" data-static-routes>
            {
              staticDrafts.map((d) => (
                <li class="rounded-[var(--radius-card)] border border-line bg-white p-6">
                  <h2 class="font-semibold">{intentLabels[d.intent]}</h2>
                  <p class="mt-1 text-[0.95rem] text-muted">{intentHelp[d.intent]}</p>
                  <p class="mt-4"><EmailLink class="link" source="contact" subject={d.subject} body={d.body} label={`Email: ${d.subject}`} /></p>
                </li>
              ))
            }
          </ul>

          <div class="rounded-[var(--radius-stage)] border border-line bg-white p-6 shadow-lift lg:sticky lg:top-28 lg:p-8" data-builder-card hidden aria-labelledby="h-draft" aria-describedby="builder-note" role="group">
            <h2 id="h-draft" class="text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">Your draft message</h2>
            {
              products.length > 0 && (
                <label class="mt-5 block">
                  <span class="text-[0.9rem] font-semibold">Select a product</span>
                  <select class={field} data-product aria-describedby="product-hint">
                    <option value="">No specific product</option>
                    {products.map((a) => <option value={a.value}>{a.label}</option>)}
                  </select>
                  <span id="product-hint" class="mt-1 block text-[0.8rem] text-muted">Adds the attraction to the subject and message.</span>
                </label>
              )
            }
            <dl class="mt-5 space-y-3 text-[0.95rem]">
              <div class="flex gap-3"><dt class="w-16 shrink-0 text-muted">To</dt><dd class="font-semibold break-all" data-out-to></dd></div>
              <div class="flex gap-3"><dt class="w-16 shrink-0 text-muted">Subject</dt><dd class="font-semibold" data-out-subject></dd></div>
            </dl>
            <label class="mt-4 block">
              <span class="flex items-center justify-between gap-3 text-[0.8rem] text-muted">
                <span>Message — you can edit it here</span>
                <button type="button" class="inline-flex items-center gap-1 font-semibold text-blue-700 hover:underline" data-reset hidden><RotateCcw class="size-3.5" aria-hidden="true" /> Rebuild from form</button>
              </span>
              <textarea rows="9" class="mt-2 w-full resize-y rounded-xl border border-line bg-paper p-4 font-sans text-[0.9rem] leading-relaxed focus:border-brand-deep focus:outline-none" data-out-body></textarea>
            </label>
            <a href="#enquiry" class="btn btn-primary mt-5 w-full" data-out-mailto data-track="mailto_open" data-track-source="contact">
              <Mail aria-hidden="true" /> Open in my email app
            </a>
            {
              wa && (
                <a href={waStatic} target="_blank" rel="noopener" class="btn btn-outline mt-2 w-full border-brand-deep/40" data-out-whatsapp data-track="whatsapp_open" data-track-source="contact">
                  <MessageCircle aria-hidden="true" /> WhatsApp Us
                </a>
              )
            }
            <div class="mt-3 grid grid-cols-2 gap-2">
              <button type="button" class="btn btn-outline min-h-11 px-3 text-[0.875rem]" data-copy="email" data-track="copy_email" data-track-source="contact"><Copy aria-hidden="true" /> Copy address</button>
              <button type="button" class="btn btn-outline min-h-11 px-3 text-[0.875rem]" data-copy="message" data-track="copy_message" data-track-source="contact"><Copy aria-hidden="true" /> Copy message</button>
              <a href="https://mail.google.com/" target="_blank" rel="noopener" class="btn btn-outline min-h-11 px-3 text-[0.875rem]" data-out-gmail data-track="gmail_compose_open" data-track-source="contact">Gmail <ExternalLink aria-hidden="true" /></a>
              <a href="https://outlook.office.com/" target="_blank" rel="noopener" class="btn btn-outline min-h-11 px-3 text-[0.875rem]" data-out-outlook data-track="outlook_compose_open" data-track-source="contact">Outlook <ExternalLink aria-hidden="true" /></a>
            </div>
            <p class="mt-4 min-h-6 text-[0.875rem] font-semibold text-brand-deep" role="status" data-status></p>
            <p id="builder-note" class="mt-1 text-[0.85rem] text-muted">
              Nothing is sent from this website. Your email app or WhatsApp opens with the message ready; review it and press send. If nothing opens, copy the address
              and message instead, or call <a href={`tel:${publicContact.phone.tel}`} class="link" data-track="phone_click" data-track-source="contact">{publicContact.phone.display}</a>.
            </p>
          </div>
        </div>
      </div>

      {
        r.capabilityProfile && (
          <div class="mt-16 flex flex-wrap items-center justify-between gap-6 rounded-[var(--radius-card)] border border-line bg-white p-8">
            <div>
              <h2 class="t-h3">Capability profile</h2>
              <p class="mt-2 text-muted">An overview of our attractions and delivery capabilities (PDF).</p>
            </div>
            <a href={`/documents/${r.capabilityProfile.file}`} download class="btn btn-outline" data-track="capability_profile_download" data-track-source="contact">
              <Download aria-hidden="true" /> Download profile
            </a>
          </div>
        )
      }
      {
        company.contact.responseProcess.confirmed && (
          <div class="mt-16 max-w-2xl">
            <h2 class="t-h3">What happens next</h2>
            <p class="mt-3 text-muted">{company.contact.responseProcess.value}</p>
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ Section 2: office location ════════════════════════════════════════ -->
  {
    loc.verified && (
      <section id="office" class="scroll-mt-24 bg-white" aria-labelledby="h-office">
        <div class="wrap py-16 lg:py-24">
          <p class="eyebrow text-blue-700">Visit us</p>
          <h2 id="h-office" class="t-h2 mt-5">Office location</h2>
          <div class="mt-10">
            <OfficeMap />
          </div>
        </div>
      </section>
    )
  }

  <script>
    import '../scripts/contact.ts';
  </script>
</Base>

---
/**
 * Contact — exactly two major sections:
 *   1. #enquiry  LEFT: informational (intro, email, phone, WhatsApp). RIGHT: the enquiry card —
 *                category selector, name + phone, live email preview, Send Enquiry (sent from the
 *                page via the Pages Function functions/api/enquiry.ts → Turnstile → Resend), WhatsApp.
 *   2. #office   Office location map.
 * Without JS the card cannot send (Turnstile needs JS); a short fallback points to the direct
 * contact details on the left.
 */
import { Mail, Phone, MessageCircle, Send, Download } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OfficeMap from '../components/OfficeMap.astro';
import EmailLink from '../components/EmailLink.astro';
import { site } from '../lib/content.ts';
import { composeEnquiry, whatsappHref, whatsappText } from '../lib/enquiry.ts';
import { company, publicContact } from '../config/company.ts';

const r = await site();
const categories = r.enquiryCategories;
// Context links from attraction pages carry a product slug; map it to its classification (publishable products only).
const productCategory = Object.fromEntries(r.attractions.map((a) => [a.slug, a.primaryCategory]));
const wa = company.contact.whatsapp.value;
const waDisplay = publicContact.phone.display;
const initial = composeEnquiry({ intent: 'project', name: '' });
const waStatic = wa ? whatsappHref(wa, whatsappText({ intent: 'general', name: '' }).replace('\n[Your name]', '')) : '';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const loc = company.contact.location;
const input =
  'mt-1.5 block w-full rounded-xl border border-line-strong bg-white px-3.5 py-2.5 text-[0.95rem] transition-colors focus:border-brand-deep focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-violet/20 aria-[invalid=true]:border-red-600';
const detailLabel = 'block text-[0.8rem] font-semibold tracking-[0.08em] text-muted uppercase';
---

<Base
  title="Contact"
  description="Contact Mega Fun Amusements: send an enquiry from this page, email, phone or WhatsApp us, and find our Chennai office."
  pageType="contact"
>
  <script is:inline>
    // Contextual query variants must not be indexed; the canonical stays /contact/.
    if (location.search) document.querySelector('meta[name=robots]').setAttribute('content', 'noindex, follow');
  </script>

  <!-- ══ Section 1: contact & enquiry ══════════════════════════════════════ -->
  <section id="enquiry" class="scroll-mt-24 border-b border-line" aria-labelledby="contact-title">
    <div class="wrap pt-8 pb-16 lg:pt-10 lg:pb-24">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
      <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-14">
        <!-- Left: informational only -->
        <div class="lg:col-span-6 xl:col-span-7">
          <p class="eyebrow text-blue-700" data-hero-line>Contact</p>
          <h1 id="contact-title" class="t-display mt-5 max-w-[16ch]" data-hero-line>Discuss a project, or just get in touch</h1>
          <p class="t-lead mt-6 max-w-[52ch] text-muted" data-hero-line>
            Choose the type of attraction you're interested in, add your name and send your enquiry straight from this page. Or reach us directly by email, phone
            or WhatsApp.
          </p>

          <dl class="mt-10 grid max-w-xl gap-6 rounded-[var(--radius-card)] border border-line bg-white p-6 lg:p-8" data-hero-line>
            <div class="flex gap-3">
              <Mail class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
              <div><dt class={detailLabel}>Email</dt><dd class="mt-1 font-semibold [overflow-wrap:anywhere]"><EmailLink class="hover:text-blue-700" source="contact" /></dd></div>
            </div>
            <div class="flex gap-3">
              <Phone class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
              <div><dt class={detailLabel}>Phone</dt><dd class="mt-1 font-semibold"><a href={`tel:${publicContact.phone.tel}`} class="hover:text-blue-700" data-track="phone_click" data-track-source="contact">{publicContact.phone.display}</a></dd></div>
            </div>
            {
              wa && (
                <div class="flex gap-3">
                  <MessageCircle class="mt-0.5 size-5 shrink-0 text-brand-violet" aria-hidden="true" />
                  <div>
                    <dt class={detailLabel}>WhatsApp</dt>
                    <dd class="mt-1 font-semibold">
                      <a href={waStatic} target="_blank" rel="noopener" class="hover:text-blue-700" data-track="whatsapp_open" data-track-source="contact">{waDisplay}</a>
                    </dd>
                  </div>
                </div>
              )
            }
          </dl>
        </div>

        <!-- Right: the enquiry card -->
        <div class="lg:col-span-6 xl:col-span-5">
          <noscript>
            <div class="rounded-[var(--radius-stage)] border border-line bg-white p-6 lg:p-8">
              <p class="font-semibold">Sending from this page needs JavaScript.</p>
              <p class="mt-2 text-muted">Please email, call or WhatsApp us using the details on this page.</p>
            </div>
          </noscript>

          <form
            class="relative rounded-[var(--radius-stage)] border border-line bg-white p-6 shadow-lift lg:sticky lg:top-28 lg:p-8"
            action="/api/enquiry"
            method="post"
            novalidate
            hidden
            data-enquiry
            data-turnstile-key={turnstileKey}
            data-product-category={JSON.stringify(productCategory)}
            aria-labelledby="h-enquiry"
            aria-describedby="enquiry-note"
          >
            <h2 id="h-enquiry" class="text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">Your enquiry</h2>

            {
              categories.length > 0 && (
                <label class="mt-5 block">
                  <span class="text-[0.85rem] font-semibold">Select attraction category</span>
                  <select name="category" class={input}>
                    <option value="">Any / not sure yet</option>
                    {categories.map((c) => <option value={c.id}>{c.name}</option>)}
                  </select>
                </label>
              )
            }

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="text-[0.85rem] font-semibold">Your name <span class="text-muted" aria-hidden="true">*</span></span>
                <input name="name" class={input} autocomplete="name" required maxlength="80" aria-describedby="err-name" />
                <span id="err-name" class="mt-1 block text-[0.8rem] font-semibold text-red-700" data-error="name"></span>
              </label>
              <label class="block">
                <span class="text-[0.85rem] font-semibold">Phone number <span class="font-normal text-muted">(optional)</span></span>
                <input name="phone" type="tel" class={input} autocomplete="tel" inputmode="tel" maxlength="24" aria-describedby="err-phone" />
                <span id="err-phone" class="mt-1 block text-[0.8rem] font-semibold text-red-700" data-error="phone"></span>
              </label>
            </div>
            <!-- Honeypot for bots; hidden from people and assistive tech. -->
            <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
              <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
            </div>

            <dl class="mt-5 space-y-2 border-t border-line pt-5 text-[0.9rem]">
              <div class="flex gap-3"><dt class="w-16 shrink-0 text-muted">To</dt><dd class="font-semibold">Mega Fun Amusements team</dd></div>
              <div class="flex gap-3"><dt class="w-16 shrink-0 text-muted">Subject</dt><dd class="font-semibold" data-out-subject>{initial.subject}</dd></div>
            </dl>
            <label class="mt-3 block">
              <span class="flex items-baseline justify-between gap-3">
                <span class="text-[0.85rem] font-semibold">Message</span>
                <button type="button" class="text-[0.8rem] font-semibold text-blue-700 underline-offset-4 hover:underline" data-restore hidden>Restore suggested message</button>
              </span>
              <textarea
                name="message"
                rows="11"
                maxlength="3000"
                class="mt-1.5 block w-full resize-y rounded-xl border border-line bg-paper px-5 py-4 text-[0.92rem] leading-relaxed transition-colors focus:border-brand-deep focus:bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-violet/20 aria-[invalid=true]:border-red-600"
                aria-describedby="err-message message-hint"
                data-out-body>{initial.text}</textarea>
              <span id="message-hint" class="mt-1 block text-[0.8rem] text-muted">Written for you from your details. Edit it freely; this is exactly what we receive.</span>
              <span id="err-message" class="mt-1 block text-[0.8rem] font-semibold text-red-700" data-error="message"></span>
            </label>

            <div class="mt-4 empty:hidden" data-turnstile></div>

            <button type="submit" class="btn btn-primary mt-5 w-full disabled:cursor-not-allowed disabled:opacity-70" data-send>
              <Send aria-hidden="true" /> <span data-send-label>Send Enquiry</span>
            </button>
            {
              wa && (
                <a href={waStatic} target="_blank" rel="noopener" class="btn btn-outline mt-2 w-full border-brand-deep/40" data-out-whatsapp data-track="whatsapp_open" data-track-source="contact">
                  <MessageCircle aria-hidden="true" /> WhatsApp Us
                </a>
              )
            }
            <p class="mt-4 min-h-5 text-[0.875rem] font-semibold" role="status" aria-live="polite" data-status></p>
            <p id="enquiry-note" class="mt-1 text-[0.8rem] text-muted">
              Your enquiry is sent directly to our team from this page. Add a phone number so we can call or message you back. WhatsApp opens with the same message
              for you to send.
            </p>
          </form>
        </div>
      </div>

      {
        r.capabilityProfile && (
          <div class="mt-16 flex flex-wrap items-center justify-between gap-6 rounded-[var(--radius-card)] border border-line bg-white p-8">
            <div>
              <h2 class="t-h3">Capability profile</h2>
              <p class="mt-2 text-muted">An overview of our attractions and delivery capabilities (PDF).</p>
            </div>
            <a href={`/documents/${r.capabilityProfile.file}`} download class="btn btn-outline" data-track="capability_profile_download" data-track-source="contact">
              <Download aria-hidden="true" /> Download profile
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ Section 2: office location ════════════════════════════════════════ -->
  {
    loc.verified && (
      <section id="office" class="scroll-mt-24 bg-white" aria-labelledby="h-office">
        <div class="wrap py-16 lg:py-24">
          <p class="eyebrow text-blue-700">Visit us</p>
          <h2 id="h-office" class="t-h2 mt-5">Office location</h2>
          <div class="mt-10">
            <OfficeMap />
          </div>
        </div>
      </section>
    )
  }

  <script>
    import '../scripts/contact.ts';
  </script>
</Base>

---
/** /solutions/ — only when ≥2 venue pages pass the Solutions gate. */
import { ArrowUpRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EnquiryClose from '../../components/EnquiryClose.astro';
import DraftFlag from '../../components/DraftFlag.astro';
import { site } from '../../lib/content.ts';

export async function getStaticPaths() {
  return (await site()).solutionsLive ? [{ params: { index: undefined } }] : [];
}
const r = await site();
const live = r.venues.filter((v) => v.hasPage);
---

<Base title="Solutions by venue" description="Attraction options and planning considerations for each type of entertainment venue." pageType="solutions">
  <PageHeader crumbs={[{ label: 'Solutions' }]} eyebrow="Solutions by venue" title="Start from the venue you are planning" lead="Each venue type has its own constraints and goals. Choose yours to see suitable attractions, planning points and related projects." />
  <section class="wrap py-20 lg:py-28">
    <ul class="grid gap-6 md:grid-cols-2">
      {
        live.map((v, i) => (
          <li class="group relative flex flex-col rounded-[var(--radius-stage)] border border-line bg-white p-8 transition-shadow hover:shadow-lift lg:p-12" data-reveal>
            <span class="font-display text-[0.95rem] font-semibold text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="t-h2 mt-6"><a href={`/solutions/${v.slug}/`} class="after:absolute after:inset-0 after:content-['']">{v.name}</a></h2>
            <p class="t-lead mt-4 text-muted">{v.summary}</p>
            <p class="mt-8 text-[0.95rem] font-semibold">{v.attractions.length} suitable attractions{v.projects.length > 0 && ` · ${v.projects.length} projects`}</p>
            <DraftFlag when={v.draft} class="mt-3" />
            <ArrowUpRight class="absolute top-8 right-8 size-6 text-muted transition-colors group-hover:text-brand-deep lg:top-12 lg:right-12" aria-hidden="true" />
          </li>
        ))
      }
    </ul>
  </section>
  <div class="pt-3"><EnquiryClose source="solution" /></div>
</Base>

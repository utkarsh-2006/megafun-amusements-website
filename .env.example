# SITE_MODE controls what content renders.
#   production (default for `npm run build`): only published records with approved, in-term media.
#   preview    (default for `npm run dev`):   also renders draft/review records and pending media as
#                                             labelled placeholders, adds a preview banner and noindex.
# Set SITE_MODE=preview on Cloudflare Pages *Preview* deployments only.
SITE_MODE=

# Optional: point the content collections at a fixture library for template QA.
#   fixtures/thin  – the v0.3 thin-launch baseline
#   fixtures/full  – a fully populated sample library (every gate passes)
# Fixture builds are always treated as preview builds.
CONTENT_ROOT=

# Analytics stays disabled until a provider and the Privacy wording are approved.
# Supported: plausible. Leave empty to disable.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=

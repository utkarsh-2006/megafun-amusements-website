{
  "name": "megafun-amusements-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "node scripts/with-env.mjs SITE_MODE=preview -- astro build",
    "build:thin": "node scripts/make-fixtures.mjs && node scripts/with-env.mjs CONTENT_ROOT=fixtures/thin -- astro build --outDir dist-thin",
    "build:full": "node scripts/make-fixtures.mjs && node scripts/with-env.mjs CONTENT_ROOT=fixtures/full -- astro build --outDir dist-full",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build && npm run check:redirects",
    "wasm-fallback": "npm i --no-save --force @astrojs/compiler-binding-wasm32-wasi@0.5.3 @bruits/satteri-wasm32-wasi@0.11.7",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:redirects": "node scripts/check-redirects.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lucide/astro": "^1.74.0",
    "astro": "^7.4.12",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
